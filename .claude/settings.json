{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)"
    ],
    "ask": [
      "Edit(.claude/settings.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.githooks/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); case \"$input\" in *[Gg][Ii][Tt]*|*[Gg][Hh]*) ;; *) exit 0 ;; esac; printf '%s' \"$input\" | grep -qiE '(^|[^a-z0-9_-]|\\\\[bfnrt]|\\\\u00[0-9a-f]{2})(git|gh)([^a-z0-9_-]|$)' || exit 0; printf '%s' \"$input\" | powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.ps1\"",
            "timeout": 90,
            "statusMessage": "Checking team git rules"
          }
        ]
      }
    ]
  }
}
